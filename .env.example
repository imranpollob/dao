# Deployer / operator key
PRIVATE_KEY=0x...

# RPC URL (e.g., Alchemy, Infura, or Anvil)
RPC_URL=http://127.0.0.1:8545

# Optional: Etherscan verification
ETHERSCAN_API_KEY=...

# Production deploy requirements
# GUARDIAN_ADDRESS must be a multisig/contract, distinct from the deployer.
GUARDIAN_ADDRESS=0x...
# TOKEN_HOLDER must be a separate account/contract that can self-delegate.
TOKEN_HOLDER=0x...

# Token holder self-delegation (run DelegateToken.s.sol from this key,
# or submit token.delegate(holder) from the multisig).
TOKEN_HOLDER_PRIVATE_KEY=0x...

# Ops scripts
TOKEN=0x...
TIMELOCK=0x...
GOVERNOR=0x...
TREASURY=0x...
REGISTRY=0x...
PROPOSAL_ID=0
GRANT_ID=1
AMOUNT_WEI=1000000000000000000
AMOUNT=1000000000000000000
DESCRIPTION="Grant payout"
SUPPORT=1
REASON=""
TRY_EXECUTE=true

# Grant creation proposal (CreateGrant.s.sol)
# GRANT_TYPE: 0 = Immediate, 1 = Milestone, 2 = Vesting.
GRANT_TYPE=0
RECIPIENT=0x...
TOTAL=1000000000000000000
# TOKEN above: zero address for ETH grants, token address for ERC20 grants.
# Vesting contract address; only for GRANT_TYPE=2.
VESTING=0x0000000000000000000000000000000000000000
# Advisory metadata only; not an authorization.
REVIEWER=0x0000000000000000000000000000000000000000
PROPOSAL_REF=0
METADATA_URI=ipfs://...
MILESTONE_ID=0
EVIDENCE_URI=ipfs://...
# Milestone grants only: comma-separated base-unit integers, no spaces.
# MILESTONE_AMOUNTS=1000000000000000000,2000000000000000000
# MILESTONE_DUE_DATES=0,0

# Revocable vesting deployment
VESTING_BENEFICIARY=0x...
VESTING_TREASURY=0x...
# Must equal VESTING_TREASURY; enforced by DeployVesting.s.sol.
VESTING_ADMIN=0x...
VESTING_START=0
VESTING_DURATION=31536000
VESTING_CLIFF=0
